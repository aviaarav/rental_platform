# Copy to .env and edit. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-before-deployment

# SQLAlchemy URL. Relative sqlite paths resolve inside the instance/ folder.
DATABASE_URL=sqlite:///rental.db

# Default administrator seeded on first start.
ADMIN_EMAIL=admin@rentserve.in
ADMIN_PASSWORD=Admin@123
